---
/**
 * The hub root is now a redirect to the canonical domain.
 *
 * This page used to be a standalone documentation-hub landing with its own
 * self-referencing canonical, which made jmrplens.github.io compete with
 * jmrp.io for the same entity in search and AI answer engines (jmrp.io GEO
 * audit 2026-08-22, finding A3). The per-project documentation sites are NOT
 * served from this repo — they are project pages built from each project's own
 * repository — so only this root page changes. The previous landing is
 * preserved at /old/.
 *
 * Belt and braces: the cross-domain canonical consolidates the entity for
 * crawlers, the meta refresh moves humans, and the visible link covers agents
 * with both disabled.
 */
const TARGET = "https://jmrp.io/projects/";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>jmrplens → jmrp.io</title>
    <link rel="canonical" href={TARGET} />
    <meta http-equiv="refresh" content={`0; url=${TARGET}`} />
    <meta name="robots" content="noindex, follow" />
  </head>
  <body>
    <p>
      This page has moved to
      <a href={TARGET}>jmrp.io/projects</a> — the canonical home of these
      projects. Per-project documentation stays where it is
      (<a href="https://jmrplens.github.io/phonometry/">example</a>).
    </p>
  </body>
</html>
